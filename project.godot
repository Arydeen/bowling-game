; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bowling Game"
run/main_scene="res://scenes/lanes/Lanes.tscn"
config/features=PackedStringArray("4.5", "C#", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CurrencyManager="*res://scripts/currency_manager.gd"
Music="*res://scripts/music.gd"
GlobalData="*res://scripts/GlobalData.cs"
Player="*res://scenes/player/player.tscn"
PlayerMenuManager="*res://scripts/player/player_menu_manager.gd"
TransitionCube="*res://scenes/transition_cube.tscn"

[display]

window/size/viewport_width=320
window/size/viewport_height=180
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[dotnet]

project/assembly_name="Bowling Game"

[file_customization]

folder_colors={
"res://scenes/": "teal"
}

